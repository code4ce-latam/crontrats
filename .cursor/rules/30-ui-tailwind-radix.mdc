description: UI — Tailwind + Radix Primitives (accesibilidad + consistencia visual)
globs:
  - "src/components/**/*"
  - "src/app/**/*"
  - "src/styles/**/*"
  - "**/*.css"
  - "**/*.tsx"
alwaysApply: false
